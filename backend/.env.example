# Copy to backend/.env and fill in. Never commit the filled copy.
PINECONE_API_KEY=
OPENROUTER_API_KEY=

# Set once a corpus snapshot is frozen (technical PRD 3.3).
CORPUS_VERSION=

# Comma-separated. Add the deployed frontend origin before Milestone 5.
ALLOWED_ORIGINS=http://localhost:3000

# Offline corpus preparation (optional). A free NCBI key raises the polite rate
# from 3 to 10 requests/second: https://account.ncbi.nlm.nih.gov/settings/
NCBI_API_KEY=
NCBI_EMAIL=

# Signs clarification tokens. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
CLARIFICATION_SECRET=

# Answer generation (Milestone 4). Off by default: public generation needs
# shared admission control first (technical PRD 8.2). Local development only.
ALLOW_UNMETERED_GENERATION=false
CORPUS_PATH=
